# Copy to .env to override. By default the panel talks to Nakama on the host it was opened from.
# VITE_NAKAMA_HOST=10.20.30.10
# By default: 7350 over HTTP, 7443 (the Caddy proxy) when the panel is opened over HTTPS.
# VITE_NAKAMA_PORT=7350
# VITE_NAKAMA_SSL=false
# Must match NAKAMA_SERVER_KEY in server/.env.
VITE_NAKAMA_SERVER_KEY=defaultkey
