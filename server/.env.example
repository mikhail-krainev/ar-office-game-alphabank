# Copy to .env and replace every value. .env is ignored by git.
POSTGRES_PASSWORD=change-me-postgres
# Server key is sent by every client (game and admin panel), so it is not a secret, but it must match
# office_game/server/key in client/project.godot and VITE_NAKAMA_SERVER_KEY in admin/.env.
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_HTTP_KEY=change-me-http-key
NAKAMA_SESSION_KEY=change-me-session-key
NAKAMA_REFRESH_KEY=change-me-refresh-key
NAKAMA_CONSOLE_PASSWORD=change-me-console
# Admin panel account, created or updated on every server start. Password: 8+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
# Signs the office entry and exit QR codes. 16+ characters, only the server knows it.
PRESENCE_SECRET=change-me-presence-secret
# true only on a developer machine: dev RPCs (debug keys, emulator codes, tour) and the dev clock.
DEV_MODE=false
# Network of the default office, comma-separated CIDR prefixes or single IPs (IPv4 and IPv6). Read
# only on the first start, when the server creates that office; after that the admin edits the
# networks of every office in the panel ("Офисы"). The entry code, tasks, room codes and colleague
# picks count only from the network of the player's office. Empty turns the check off.
# Real office: its external (NAT) addresses, without the corporate VPN gateway. Nakama must then be
# reachable only through a proxy that overwrites X-Forwarded-For (see docs/web-testing-on-iphone.md).
# Leave empty for ./run-lan.sh: Docker Desktop on macOS hides the phones' addresses (every request
# comes from the Docker gateway 172.x), and only devices on the Mac's Wi-Fi reach the server anyway.
OFFICE_NETWORKS=
